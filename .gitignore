# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Claude Code personal settings (permission approvals, local overrides) —
# normally auto-excluded globally by Claude Code itself, but that only
# fires if it hasn't already been created by hand. Explicit here so a
# template clone never accidentally commits one contributor's personal
# approvals. .claude/settings.json (the shared one) stays tracked.
.claude/settings.local.json

# impeccable skill — machine-local artifacts (shared .impeccable/config.json
# stays tracked; the consent flag and session cache are per-machine)
.impeccable/config.local.json
.impeccable/hook.cache.json

# typescript
*.tsbuildinfo
next-env.d.ts
